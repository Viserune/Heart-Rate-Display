<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== WinUI 3 深色主题色板 ==================== -->

    <!-- 背景 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="PressedBackgroundBrush" Color="#454545" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9D9D9D" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#6E6E6E" />

    <!-- 强调色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6FCBFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#99D9FF" />

    <!-- 控件边框 -->
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#5C5C5C" />
    <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#8A8A8A" />

    <!-- 开关/勾选框 -->
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#666666" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CheckMarkBrush" Color="#1F1F1F" />

    <!-- 选中高亮（强调色 10%） -->
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#1A4CC2FF" />

    <!-- 状态文字（心率占位） -->
    <SolidColorBrush x:Key="HrPlaceholderBrush" Color="#6E6E6E" />

    <!-- 主窗口渐变兜底（非 Mica 系统） -->
    <LinearGradientBrush x:Key="WindowFallbackBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2A2A2A" Offset="0" />
        <GradientStop Color="#1F1F1F" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
