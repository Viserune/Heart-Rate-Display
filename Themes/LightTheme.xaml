<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== WinUI 3 亮色主题色板 ==================== -->

    <!-- 背景 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="PressedBackgroundBrush" Color="#D9D9D9" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E6E6E" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#9D9D9D" />

    <!-- 强调色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#005A9E" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#004578" />

    <!-- 控件边框 -->
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#5C5C5C" />

    <!-- 开关/勾选框 -->
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#B0B0B0" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CheckMarkBrush" Color="#FFFFFF" />

    <!-- 选中高亮（强调色 10%） -->
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#1A0067C0" />

    <!-- 状态文字（心率占位） -->
    <SolidColorBrush x:Key="HrPlaceholderBrush" Color="#999999" />

    <!-- 主窗口渐变兜底（非 Mica 系统） -->
    <LinearGradientBrush x:Key="WindowFallbackBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F0F6FC" Offset="0" />
        <GradientStop Color="#FFFFFF" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
