<Window x:Class="HeartRater.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeartRater 悬浮窗"
        Width="200" Height="115"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="True"
        WindowStartupLocation="Manual"
        SourceInitialized="OnSourceInitialized"
        PreviewMouseLeftButtonDown="OnPointerPressed"
        PreviewMouseMove="OnPointerMoved"
        PreviewMouseLeftButtonUp="OnPointerReleased">

    <!--
        完全透明背景（仅显示心率数字），无 DropShadowEffect → 不进入 WPF 软件渲染路径，
        长时间挂屏无 GPU/CPU 持续开销。
        数字下方叠一层黑色硬描影（双 TextBlock，同样无 Effect）：亮色游戏画面上仍可读。
    -->
    <Border x:Name="CardBorder" Background="Transparent">
        <StackPanel VerticalAlignment="Center">
            <Grid>
                <TextBlock x:Name="BpmShadow" Text="{Binding BpmText}" FontSize="52" FontWeight="Bold"
                           Foreground="#B3000000" Margin="0,2,0,0" HorizontalAlignment="Center"
                           FontFamily="Segoe UI Variable Display, Segoe UI" />
                <TextBlock x:Name="BpmText" Text="{Binding BpmText}" FontSize="52" FontWeight="Bold"
                           Foreground="{Binding BpmBrush}" HorizontalAlignment="Center"
                           FontFamily="Segoe UI Variable Display, Segoe UI" />
            </Grid>
            <Grid Margin="0,-2,0,0">
                <TextBlock Text="BPM" FontSize="10" Foreground="#99000000" HorizontalAlignment="Center" />
                <TextBlock Text="BPM" FontSize="10" Foreground="#E6FFFFFF" HorizontalAlignment="Center" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
