<Window x:Class="HeartRater.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeartRater 悬浮窗"
        Width="200" Height="115"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="True"
        WindowStartupLocation="Manual"
        SourceInitialized="OnSourceInitialized"
        PreviewMouseLeftButtonDown="OnPointerPressed"
        PreviewMouseMove="OnPointerMoved"
        PreviewMouseLeftButtonUp="OnPointerReleased">

    <!-- 透明窗口：AllowsTransparency 启用逐像素 alpha；背景与卡片全透明，仅心率文字不透明 -->
    <Border x:Name="CardBorder" Background="Transparent" Padding="20,10">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="BpmText" Text="--" FontSize="48" FontWeight="Bold"
                       Foreground="#C0FFFFFF" HorizontalAlignment="Center"
                       FontFamily="Segoe UI Variable Display, Segoe UI">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.45" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="BPM" FontSize="10" Foreground="#80FFFFFF" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
