<Window x:Class="HeartRater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeartRater 心率助手"
        Width="430"
        MinWidth="360"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Closing="OnWindowClosing">

    <Grid Margin="18">

        <!-- ==================== 主视图 ==================== -->
        <Grid x:Name="MainView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 实时心率 -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,8,0,14">
                <TextBlock Text="实时心率" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="HeartRateDisplay" Text="{Binding HeartRateDisplay}" FontSize="60" FontWeight="Bold"
                           Foreground="{Binding HeartRateBrush}" HorizontalAlignment="Center">
                    <TextBlock.RenderTransform>
                        <ScaleTransform x:Name="HeartRateScale" ScaleX="1" ScaleY="1" />
                    </TextBlock.RenderTransform>
                    <TextBlock.RenderTransformOrigin>0.5,0.5</TextBlock.RenderTransformOrigin>
                </TextBlock>
                <TextBlock Text="BPM" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,-6,0,0" />
                <TextBlock x:Name="DeviceNameText" Text="{Binding DeviceNameText}" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>

            <!-- 设备卡片：标准下拉框（点右侧箭头展开） -->
            <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="设备" Style="{DynamicResource CardTitleStyle}" />
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="DeviceCombo" Height="36"
                                  ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding SelectedDevice}"
                                  Style="{DynamicResource ComboBoxStyle}"
                                  ToolTip="点击右侧箭头选择设备" />
                        <Button x:Name="ScanButton" Grid.Column="1" Content="扫描设备" Width="92" Margin="8,0,0,0"
                                Command="{Binding ScanCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Button x:Name="ConnectButton" Grid.Row="2" Content="连接" Height="36" Margin="0,0,0,10"
                    Style="{DynamicResource AccentButtonStyle}" FontWeight="SemiBold"
                    Command="{Binding ConnectCommand}" />

            <!-- 底部：断开连接 + 设置 -->
            <Grid Grid.Row="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="断开连接" Height="34" Command="{Binding DisconnectCommand}" />
                <Button x:Name="SettingsButton" Grid.Column="1" Content="设置" Width="88" Height="34"
                        Margin="8,0,0,0" Click="OnSettingsClicked" />
            </Grid>

            <TextBlock x:Name="StatusText" Grid.Row="4" Text="{Binding StatusText}" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </Grid>

        <!-- ==================== 设置视图（整窗口，默认隐藏） ==================== -->
        <Grid x:Name="SettingsView" Visibility="Collapsed" Opacity="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 左上角：退出设置 -->
            <Grid>
                <Button x:Name="ExitSettingsButton" Content="← 退出" Width="80" Height="30"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Click="OnExitSettingsClicked" />
                <TextBlock Text="设置" Style="{DynamicResource CardTitleStyle}" FontSize="18"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
            </Grid>

            <!-- 设置开关 -->
            <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Margin="0,14,0,0">
                <StackPanel Margin="4,6">
                    <ToggleButton x:Name="AutoConnectToggle" Content="启动时自动连接上次设备" Margin="0,8"
                                  IsChecked="{Binding Settings.AutoConnectOnStart}" />
                    <ToggleButton x:Name="AutoStartToggle" Content="开机自动启动" Margin="0,8"
                                  IsChecked="{Binding Settings.AutoStartEnabled}" />
                    <ToggleButton x:Name="AutoReconnectToggle" Content="断线自动重连" Margin="0,8"
                                  IsChecked="{Binding Settings.AutoReconnect}" />
                    <ToggleButton x:Name="HudToggle" Content="显示桌面悬浮窗" Margin="0,8"
                                  IsChecked="{Binding Settings.HudVisible}" />
                    <ToggleButton x:Name="LockedToggle" Content="锁定悬浮窗（禁拖动 + 点击穿透）" Margin="0,8"
                                  IsChecked="{Binding Settings.HudLocked}" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
