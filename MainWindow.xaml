<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HeartRater.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="Transparent">

        <ScrollViewer>
            <StackPanel Margin="20,16,20,24" Spacing="12">

                <!-- 顶部：实时心率 -->
                <StackPanel HorizontalAlignment="Center" Spacing="0">
                    <TextBlock
                        x:Name="HeartRateDisplay"
                        Text="--"
                        FontSize="72"
                        FontWeight="Bold"
                        Foreground="#55FFFFFF"
                        HorizontalAlignment="Center" />
                    <TextBlock Text="BPM" FontSize="13" Foreground="#80FFFFFF" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                    <TextBlock
                        x:Name="DeviceNameText"
                        Text="未连接设备"
                        FontSize="13"
                        Foreground="#99FFFFFF"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0" />
                </StackPanel>

                <!-- 设备区域 -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="DeviceFilterBox"
                        PlaceholderText="搜索设备名称…"
                        TextChanged="OnDeviceFilterChanged" />
                    <Button x:Name="ScanButton" Grid.Column="1" Content="扫描设备" Click="OnScanClicked" />
                </Grid>

                <ListView
                    x:Name="DeviceList"
                    Height="220"
                    SelectionMode="Single"
                    SelectionChanged="OnDeviceSelectionChanged"
                    DisplayMemberPath="DisplayName" />

                <Button
                    x:Name="ConnectButton"
                    Content="连接"
                    HorizontalAlignment="Stretch"
                    IsEnabled="False"
                    Click="OnConnectClicked" />

                <!-- 设置区域 -->
                <TextBlock Text="设置" FontSize="14" FontWeight="SemiBold" Foreground="#CCFFFFFF" Margin="0,6,0,0"/>

                <ToggleSwitch
                    x:Name="AutoConnectToggle"
                    Header="启动时自动连接上次设备"
                    Toggled="OnAutoConnectToggled" />

                <ToggleSwitch
                    x:Name="AutoStartToggle"
                    Header="开机自动启动（托盘驻留）"
                    Toggled="OnAutoStartToggled" />

                <ToggleSwitch
                    x:Name="AutoReconnectToggle"
                    Header="断线自动重连（不死鸟模式）"
                    Toggled="OnAutoReconnectToggled" />

                <ToggleSwitch
                    x:Name="HudToggle"
                    Header="显示桌面悬浮窗"
                    Toggled="OnHudToggled" />

                <ToggleSwitch
                    x:Name="ClickThroughToggle"
                    Header="悬浮窗点击穿透"
                    Toggled="OnClickThroughToggled" />

                <Grid ColumnSpacing="8" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="开启演示模式" Click="OnDemoClicked" />
                    <Button Grid.Column="1" Content="断开连接" Click="OnDisconnectClicked" />
                </Grid>

                <TextBlock
                    x:Name="StatusText"
                    Text="就绪"
                    FontSize="12"
                    Foreground="#66FFFFFF"
                    TextWrapping="Wrap"
                    Margin="0,6,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="LoadingOverlay" Background="#B0000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <ProgressRing IsActive="True" Width="40" Height="40" />
                <TextBlock x:Name="OverlayText" Text="正在扫描…" HorizontalAlignment="Center" Foreground="White"/>
            </StackPanel>
        </Grid>

    </Grid>

</Window>
